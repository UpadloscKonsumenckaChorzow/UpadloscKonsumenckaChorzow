# Nagłówki dla plików statycznych serwowanych bezpośrednio przez Cloudflare
# (bez udziału Workera). Strony HTML dostają nagłówki z next.config.mjs.
# https://developers.cloudflare.com/workers/static-assets/headers

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Pliki z hashem w nazwie – nigdy się nie zmieniają.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Grafiki z /public nie mają hasha w nazwie: tydzień w cache przeglądarki,
# potem cicha aktualizacja w tle.
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
